{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_*",
    "DATABASE_URL",
    "DIRECT_URL",
    "CLERK_*",
    "SUPABASE_SERVICE_ROLE_KEY",
    "REDIS_*",
    "CORS_ORIGIN",
    "WEBHOOK_URL",
    "WHATSAPP_*",
    "AI_PROVIDER",
    "OPENROUTER_*",
    "OPENAI_API_KEY",
    "GEMINI_*",
    "API_BASE_URL",
    "API_PORT",
    "API_HOST",
    "JWT_SECRET",
    "ENCRYPTION_KEY",
    "ENABLE_AUTH_SNAPSHOTS",
    "SNAPSHOT_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/test/**",
        "!**/tests/**"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "!build/cache/**"
      ],
      "env": ["NODE_ENV", "NEXT_PUBLIC_*", "API_URL", "WHATSAPP_SERVICE_URL", "WHATSAPP_SERVICE_PORT", "API_PORT"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": [
        "src/**/*.{js,ts,jsx,tsx}",
        "app/**/*.{js,ts,jsx,tsx}",
        "components/**/*.{js,ts,jsx,tsx}",
        "lib/**/*.{js,ts,jsx,tsx}",
        ".eslintrc*",
        "eslint.config.*"
      ]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "inputs": [
        "src/**/*.{js,ts,jsx,tsx}",
        "app/**/*.{js,ts,jsx,tsx}",
        "components/**/*.{js,ts,jsx,tsx}",
        "lib/**/*.{js,ts,jsx,tsx}",
        ".eslintrc*",
        "eslint.config.*"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "db:generate"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "app/**/*.{ts,tsx}",
        "components/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "tsconfig.json",
        "**/*.d.ts"
      ]
    },
    "test": {
      "dependsOn": ["^test"],
      "inputs": [
        "src/**/*.{js,ts,jsx,tsx}",
        "**/*.test.{js,ts,jsx,tsx}",
        "**/*.spec.{js,ts,jsx,tsx}",
        "jest.config.*"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^test:e2e", "build"]
    },
    "test:cov": {
      "dependsOn": ["^test:cov"]
    },
    "db:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", ".env*"],
      "outputs": ["node_modules/.pnpm/**"]
    },
    "db:migrate:dev": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate:reset": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
