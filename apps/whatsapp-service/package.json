{
  "name": "@leadcrm/whatsapp-service",
  "version": "0.1.0",
  "description": "WhatsApp integration service for LeadsCRM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "cleanup-sessions": "tsx cleanup-sessions.ts",
    "cleanup-chrome": "pwsh -ExecutionPolicy Bypass -File scripts/cleanup-chrome.ps1",
    "cleanup-chrome-force": "pwsh -ExecutionPolicy Bypass -File scripts/cleanup-chrome.ps1 -Force",
    "analyze:circular": "madge --circular --extensions ts src/",
    "analyze:unused": "ts-prune --project tsconfig.json"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@leadcrm/db": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.7.0",
    "openai": "^4.28.4",
    "puppeteer": "^24.37.2",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "whatsapp-web.js": "^1.34.6",
    "winston": "^3.12.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@leadcrm/config-eslint": "workspace:*",
    "@leadcrm/config-ts": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.19.11",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.5.0",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "ts-prune": "^0.10.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
