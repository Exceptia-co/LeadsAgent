# WhatsApp Service Configuration

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration (comma separated URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Logging Configuration
LOG_LEVEL=info

# Redis Configuration (for session storage)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=whatsapp:

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_WEBHOOK_URL=http://localhost:3001/api/whatsapp/webhook
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-key

# AI Service Configuration (IMPORTANTE: LEER COMENTARIOS)
# El modelo openai/gpt-oss-120b está HARDCODEADO en src/config/ai.config.ts
# NO se puede cambiar via variables de entorno (previene uso de Claude 3.5 Sonnet)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Google Gemini (alternativo)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (legacy - para compatibilidad)
OPENAI_API_KEY=your-openai-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Session Configuration
SESSION_CLEANUP_INTERVAL=300000  # 5 minutes in milliseconds
SESSION_MAX_IDLE_TIME=3600000   # 1 hour in milliseconds

# Puppeteer Configuration (for headless browser)
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# Database (if using database for session persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/leadcrm

# Security
JWT_SECRET=your-jwt-secret-for-api-auth

# Development flags
DEBUG_WHATSAPP=false
DEBUG_PUPPETEER=false

# Service Architecture Configuration
# Set to 'true' to use the new modular architecture (WhatsAppServiceRefactored)
# Set to 'false' to use the legacy monolithic service (WhatsAppServiceSimple)
USE_WHATSAPP_REFACTORED=false

# Database Architecture Configuration  
# Set to 'true' to use the complete repository pattern (6 repositories: Lead, Conversation, KnowledgeBase, AIConfig, Training, WhitelistLog)
# Set to 'false' to use the legacy monolithic DatabaseService
# Phase 2c includes Training and WhitelistLog repositories with advanced analytics and security monitoring
USE_DATABASE_REPOSITORIES=false

# AI Services Architecture Configuration (Phase 3)
# Set to 'true' to use the modular AI thinking services (5 modules: ContextEnricher, KnowledgeRetrieval, StrategySelector, DecisionEngine, ResponseGenerator)
# Set to 'false' to use the legacy monolithic AIThinkingService
# Phase 3 breaks down the 1,686-line AIThinkingService into maintainable, testable modules
USE_AI_MODULAR_SERVICES=false

# Session Recovery Architecture Configuration (Phase 4)
# Set to 'true' to use the modular session recovery architecture (4 modules: AuthValidator, RecoveryRunner, HealthMetrics, AlertsService)
# Set to 'false' to use the legacy monolithic SessionRecoveryService
# Phase 4 breaks down the 1,069-line SessionRecoveryService into maintainable, testable modules with enhanced monitoring and alerting
USE_SESSION_RECOVERY_MODULAR=false

# AI Response Architecture Configuration (Phase 5)
# Set to 'true' to use the modular AI response architecture (4 modules: ContextBuilder, PromptBuilder, ResponsePersonalizer, QualityEvaluator)
# Set to 'false' to use the legacy monolithic AIEnhancedResponseService
# Phase 5 breaks down the 862-line AIEnhancedResponseService into maintainable, testable modules with enhanced quality evaluation and personalization
USE_AI_RESPONSE_MODULAR=false

# AI Learning Architecture Configuration (Phase 6)
# Set to 'true' to use the modular AI learning architecture (4 modules: InteractionTracker, PatternAnalyzer, KnowledgeGenerator, PerformanceAnalyzer)
# Set to 'false' to use the legacy monolithic AILearningService
# Phase 6 breaks down the 759-line AILearningService into maintainable, testable modules with enhanced analytics and optimization features
USE_AI_LEARNING_MODULAR=false

# File upload limits
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Webhook retry configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000  # 1 second

# API Base URL (for internal API calls)
API_BASE_URL=http://localhost:3001/api
