# WhatsApp Service Configuration

# Server Configuration
PORT=3002
NODE_ENV=development

# CORS Configuration (comma separated URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Logging Configuration
LOG_LEVEL=info

# Redis Configuration (for session storage)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=whatsapp:

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./sessions
WHATSAPP_WEBHOOK_URL=http://localhost:3001/api/whatsapp/webhook
WHATSAPP_WEBHOOK_SECRET=your-webhook-secret-key

# AI Service Configuration (IMPORTANTE: LEER COMENTARIOS)
# El modelo openai/gpt-oss-120b está HARDCODEADO en src/config/ai.config.ts
# NO se puede cambiar via variables de entorno (previene uso de Claude 3.5 Sonnet)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Google Gemini (alternativo)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (legacy - para compatibilidad)
OPENAI_API_KEY=your-openai-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Session Configuration
SESSION_CLEANUP_INTERVAL=300000  # 5 minutes in milliseconds
SESSION_MAX_IDLE_TIME=3600000   # 1 hour in milliseconds

# Puppeteer Configuration (for headless browser)
PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# Database (if using database for session persistence)
DATABASE_URL=postgresql://user:password@localhost:5432/leadcrm

# Security
JWT_SECRET=your-jwt-secret-for-api-auth

# Development flags
DEBUG_WHATSAPP=false
DEBUG_PUPPETEER=false

# File upload limits
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Webhook retry configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000  # 1 second

# API Base URL (for internal API calls)
API_BASE_URL=http://localhost:3001/api
