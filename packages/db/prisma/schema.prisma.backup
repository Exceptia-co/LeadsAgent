generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerk_id          String    @unique @db.VarChar(255)
  email             String    @db.VarChar(255)
  first_name        String?   @db.VarChar(255)
  last_name         String?   @db.VarChar(255)
  profile_image_url String?   @db.VarChar(500)
  role              String?   @default("user") @db.VarChar(50)
  is_active         Boolean?  @default(true)
  last_login_at     DateTime? @db.Timestamptz(6)
  settings          Json?     @default("{}")
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([clerk_id], map: "idx_users_clerk_id")
  @@index([created_at], map: "idx_users_created_at")
  @@index([email], map: "idx_users_email")
  @@index([is_active], map: "idx_users_is_active")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model Lead {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String?                  @db.VarChar(255)
  email                  String?                  @db.VarChar(255)
  phone                  String                   @unique @db.VarChar(50)
  status                 String?                  @default("new") @db.VarChar(100)
  source                 String?                  @db.VarChar(255)
  tags                   Json?                    @default("[]")
  whatsapp_authorized    Boolean?                 @default(true)
  mood_score             Decimal?                 @db.Decimal(3, 2)
  last_contact           DateTime?                @db.Timestamptz(6)
  assigned_to            String?                  @db.VarChar(255)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @db.Timestamptz(6)
  messages               Message[]
  proactive_messages     proactive_messages[]
  whatsapp_conversations whatsapp_conversations[]

  @@index([created_at], map: "idx_leads_created_at")
  @@index([phone], map: "idx_leads_phone")
  @@index([status], map: "idx_leads_status")
  @@map("leads")
}

model Message {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id             String?   @db.Uuid
  content             String
  direction           String    @db.VarChar(20)
  message_type        String?   @default("text") @db.VarChar(50)
  status              String?   @default("pending") @db.VarChar(50)
  session_id          String?   @db.VarChar(255)
  whatsapp_message_id String?   @db.VarChar(255)
  metadata            Json?     @default("{}")
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  leads               Lead?     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_messages_created_at")
  @@index([direction], map: "idx_messages_direction")
  @@index([lead_id], map: "idx_messages_lead_id")
  @@map("messages")
}

model ai_configuration {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  config_key   String    @unique @db.VarChar(100)
  config_value String
  description  String?
  updated_by   String?   @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  @@index([config_key], map: "idx_ai_config_key")
}

model ai_knowledge_base {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category   String    @db.VarChar(100)
  title      String    @db.VarChar(255)
  content    String
  keywords   String[]
  priority   Int?      @default(1)
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([is_active], map: "idx_knowledge_active")
  @@index([category], map: "idx_knowledge_category")
  @@index([priority(sort: Desc)], map: "idx_knowledge_priority")
}

model message_templates {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @db.VarChar(255)
  category           String               @db.VarChar(100)
  subject            String?              @db.VarChar(500)
  content            String
  variables          Json?                @default("[]")
  is_active          Boolean?             @default(true)
  usage_count        Int?                 @default(0)
  created_by         String?              @db.VarChar(255)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  proactive_messages proactive_messages[]

  @@index([is_active], map: "idx_templates_active")
  @@index([category], map: "idx_templates_category")
  @@index([usage_count(sort: Desc)], map: "idx_templates_usage")
}

model proactive_messages {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id           String?            @db.Uuid
  template_id       String?            @db.Uuid
  template_name     String?            @db.VarChar(255)
  phone_number      String             @db.VarChar(50)
  content           String
  status            String?            @default("pending") @db.VarChar(50)
  variables         Json?
  session_id        String?            @db.VarChar(255)
  sent_at           DateTime?          @db.Timestamptz(6)
  delivered_at      DateTime?          @db.Timestamptz(6)
  error_message     String?
  created_by        String?            @db.VarChar(255)
  created_at        DateTime?          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?          @default(now()) @db.Timestamptz(6)
  leads             Lead?              @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message_templates message_templates? @relation(fields: [template_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_proactive_created")
  @@index([lead_id], map: "idx_proactive_lead")
  @@index([created_at], map: "idx_proactive_messages_created_at")
  @@index([lead_id], map: "idx_proactive_messages_lead_id")
  @@index([status], map: "idx_proactive_messages_status")
  @@index([phone_number], map: "idx_proactive_phone")
  @@index([status], map: "idx_proactive_status")
}

model whatsapp_conversations {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id         String?   @db.Uuid
  session_id      String    @db.VarChar(255)
  phone_number    String    @db.VarChar(50)
  last_message_at DateTime? @db.Timestamptz(6)
  message_count   Int?      @default(0)
  status          String?   @default("active") @db.VarChar(50)
  metadata        Json?     @default("{}")
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  ai_provider     String?   @default("gemini") @db.VarChar(50)
  leads           Lead?     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_whatsapp_created")
  @@index([phone_number], map: "idx_whatsapp_phone")
  @@index([session_id], map: "idx_whatsapp_session")
}

model whatsapp_whitelist_logs {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone_number String    @db.VarChar(50)
  action       String    @db.VarChar(50)
  reason       String?
  created_by   String?   @db.VarChar(255)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  decision     String?   @db.VarChar(50)
  session_id   String?   @db.VarChar(255)

  @@index([created_at], map: "idx_whitelist_logs_created")
  @@index([decision], map: "idx_whitelist_logs_decision")
  @@index([phone_number], map: "idx_whitelist_logs_phone")
  @@index([session_id], map: "idx_whitelist_logs_session")
}
