{
  "name": "@leadcrm/db",
  "version": "0.1.0",
  "description": "Database schema and Prisma client for LeadsCRM",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "postinstall": "prisma generate || echo '[prisma generate] skipped (binary missing on this platform)'",
    "db:generate": "prisma generate",
    "db:generate:win": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-windows.ps1",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:smoke": "tsx scripts/seed-smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "6.15.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "prisma": "6.15.0",
    "tsx": "^4.7.1"
  }
}
