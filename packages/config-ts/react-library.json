{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Library",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "dom"],
    "module": "ESNext",
    "skipLibCheck": true,
    "bundler": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx"
  }
}
