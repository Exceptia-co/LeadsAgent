{
  "mcpServers": {
    "codex": {
      "type": "stdio",
      "command": "codex",
      "args": ["mcp-server"]
    },
    "gemini-cli": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@tuannvm/gemini-mcp-server"]
    },
    "browsermcp": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "@browsermcp/mcp@latest"],
      "env": {
        "PLAYWRIGHT_CHROMIUM_ARGS": "--disable-gpu --disable-software-rasterizer"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    }
  }
}
