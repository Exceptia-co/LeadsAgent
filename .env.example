# Database Configuration (PostgreSQL - Supabase)
# URL con pooler (para aplicación) - Reemplaza con tu información de Supabase
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxx:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# URL directa (para migraciones) - Necesaria para evitar pooler en migraciones
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxx:your_password@aws-0-us-east-1.compute-1.amazonaws.com:5432/postgres"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_from_supabase_dashboard"

# Authentication (Clerk)
CLERK_SECRET_KEY="your-clerk-secret-key"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"
CLERK_WEBHOOK_SECRET="your-clerk-webhook-secret"

# URLs para redirección de autenticación
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# AI Service (OpenAI)
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL="gpt-3.5-turbo"

# Redis Configuration (opcional)
REDIS_URL="redis://localhost:6379"

# WhatsApp Service Configuration
WHATSAPP_WEBHOOK_SECRET="your_webhook_secret"
WHATSAPP_SERVICE_URL="http://localhost:3002"
WHATSAPP_SERVICE_PORT=3002
WEBHOOK_URL="http://localhost:3001/whatsapp/webhook"

# API Configuration
API_PORT=3001
API_HOST="0.0.0.0"
NODE_ENV="development"

# Dashboard Configuration
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret"

# Security
JWT_SECRET="your_jwt_secret_key"
ENCRYPTION_KEY="your_32_character_encryption_key"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="combined"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003"
