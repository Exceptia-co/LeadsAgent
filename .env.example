# ===========================================
# LeadsCRM - Development Environment
# ===========================================
# Copia este archivo como .env y completa con tus credenciales

# ===========================================
# Database (Supabase PostgreSQL)
# ===========================================
# Obtener de: Supabase Dashboard > Project Settings > Database
# URL con pooler (para aplicación - puerto 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL directa (para migraciones Prisma - puerto 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_from_supabase_dashboard"

# ===========================================
# Authentication (Clerk)
# ===========================================
# Obtener de: Clerk Dashboard > API Keys
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"

# URLs para redirección de autenticación
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ===========================================
# AI Service Configuration
# ===========================================
AI_PROVIDER="openrouter"
AI_RESPONSE_DELAY_MIN="2000"
AI_RESPONSE_DELAY_MAX="6000"

# OpenRouter (proveedor principal)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-oss-120b"

# Google Gemini (alternativo, dejar vacío si no se usa)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ===========================================
# Redis (Docker - única dependencia local)
# ===========================================
REDIS_URL="redis://localhost:6381"
REDIS_HOST="localhost"
REDIS_PORT="6381"

# ===========================================
# Service Ports (Development)
# ===========================================
# Dashboard: 3001 (Next.js)
# API:       3003 (NestJS)
# WhatsApp:  3002 (Express)
# Redis:     6381 (Docker)

API_PORT=3003
API_HOST="0.0.0.0"
NODE_ENV="development"

# ===========================================
# WhatsApp Service Configuration
# ===========================================
WHATSAPP_SERVICE_PORT=3002
WHATSAPP_ENABLE_AUTO_RECOVERY=false
WHATSAPP_WEBHOOK_SECRET="your_webhook_secret"
WHATSAPP_SERVICE_URL="http://localhost:3002"
WEBHOOK_URL="http://localhost:3003/whatsapp/webhook"

# ===========================================
# Dashboard Configuration
# ===========================================
NEXT_PUBLIC_API_URL="http://localhost:3003"
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your_nextauth_secret"

# ===========================================
# Security
# ===========================================
JWT_SECRET="your_jwt_secret_key"
ENCRYPTION_KEY="your_32_character_encryption_key"

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN="http://localhost:3001,http://localhost:3002,http://localhost:3003"

# ===========================================
# Logging & Rate Limiting
# ===========================================
LOG_LEVEL="debug"
LOG_FORMAT="combined"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
