# ===========================================
# LeadsCRM - Development Environment
# ===========================================
# Copia este archivo como .env y completa con tus credenciales
# Este es el UNICO template de env vars del monorepo.
# Los servicios leen este .env desde la raiz via Turborepo.

# ===========================================
# Database (Supabase PostgreSQL)
# ===========================================
# Obtener de: Supabase Dashboard > Project Settings > Database
# NOTE: Use a DEV-ONLY Supabase project here to avoid mixing with production data.
# URL con pooler (para aplicacion - puerto 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL directa (para migraciones Prisma - puerto 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_from_supabase_dashboard"

# ===========================================
# Authentication (Clerk)
# ===========================================
# Obtener de: Clerk Dashboard > API Keys
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_secret"
CLERK_ORG_WEBHOOK_SECRET="whsec_your_clerk_organization_webhook_secret"
CLERK_ISSUER="https://your-clerk-instance.clerk.accounts.dev"
CLERK_DEBUG_AUTH=false

# URLs para redireccion de autenticacion
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ===========================================
# AI Service Configuration
# ===========================================
AI_PROVIDER="openrouter"
AI_RESPONSE_DELAY_MIN="2000"
AI_RESPONSE_DELAY_MAX="6000"

# OpenRouter (proveedor principal)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-oss-120b"

# Google Gemini (alternativo, dejar vacio si no se usa)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# ===========================================
# Redis (Docker - unica dependencia local)
# ===========================================
REDIS_URL="redis://localhost:6381"
REDIS_HOST="localhost"
REDIS_PORT="6381"
REDIS_PREFIX="whatsapp:"

# ===========================================
# Service Ports (Development)
# ===========================================
# Dashboard: 3001 (Next.js)
# API:       3003 (NestJS)
# WhatsApp:  3002 (Express)
# Redis:     6381 (Docker)

API_PORT=3003
API_HOST="0.0.0.0"
NODE_ENV="development"

# ===========================================
# WhatsApp Service Configuration
# ===========================================
WHATSAPP_SERVICE_PORT=3002
# Reconnect known sessions at boot instead of waiting for someone to click
# Create in the dashboard. Off by default in the Chromium era, when recovery
# meant spawning a browser per session; under Baileys it is a socket plus a
# read of `whatsapp_auth_keys`, and a session that does not survive a restart
# is the thing users notice. Sessions with no stored credentials are skipped
# (they need a QR), as are the ones a user disconnected on purpose.
WHATSAPP_ENABLE_AUTO_RECOVERY=true
WHATSAPP_WEBHOOK_SECRET="your_webhook_secret"
WHATSAPP_SERVICE_URL="http://localhost:3002"
WEBHOOK_URL="http://localhost:3003/whatsapp/webhook"
WHATSAPP_SESSION_PATH="./sessions"


# Proactive messaging consent window.
# A proactive send requires BOTH whatsapp_authorized=true AND an inbound
# message from that lead, on that same session, within this many days.
# Default 30. Capped at 90 in code, so raising it further has no effect.
PROACTIVE_INBOUND_WINDOW_DAYS=30

# WhatsApp Lead Management
WHATSAPP_ALLOW_NEW_LEADS=true
WHATSAPP_REQUIRE_WHITELIST=true
WHATSAPP_BLOCK_NEWSLETTERS=true

# Session Configuration
SESSION_CLEANUP_INTERVAL=300000
SESSION_MAX_IDLE_TIME=3600000

# ===========================================
# Dashboard Configuration
# ===========================================
NEXT_PUBLIC_API_URL="http://localhost:3003"
NEXT_PUBLIC_WHATSAPP_SERVICE_URL="http://localhost:3002"
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your_nextauth_secret"

# ===========================================
# Security
# ===========================================
JWT_SECRET="your_jwt_secret_key"
ENCRYPTION_KEY="your_32_character_encryption_key"

# ===========================================
# CORS Configuration
# ===========================================
CORS_ORIGIN="http://localhost:3001,http://localhost:3002,http://localhost:3003"

# ===========================================
# Logging & Rate Limiting
# ===========================================
LOG_LEVEL="debug"
LOG_FORMAT="combined"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Debug Flags
# ===========================================
DEBUG_WHATSAPP=false

# ===========================================
# File Upload & Webhook Retry
# ===========================================
MAX_FILE_SIZE=10485760
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000

# ===========================================
# Internal API URL (for WhatsApp -> API calls)
# ===========================================
API_BASE_URL="http://localhost:3003/api"

# ===========================================
# ============================================
# Service-to-service authentication (T0.4-ter)
# ============================================
# HMAC secret compartido por los 3 apps: dashboard (proxy Next), API Nest y
# whatsapp-service. El dashboard y la API firman cada request saliente;
# whatsapp-service verifica la firma. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotar simultáneamente en Vercel, en .env del VPS Hetzner y en el .env local.
WHATSAPP_SERVICE_HMAC_SECRET=

# Operator role (PR5a-quinquies). Tenant UUID tratado como "operator" para
# mutaciones globales que cruzan tenants: /ai/switch, PUT /system/variables,
# /sessions/health. Dejar UNSET en producción (default fail-closed: 403).
# PR5b lo reemplazará por un claim de rol propio en el JWT de Clerk.
WHATSAPP_OPERATOR_HMAC_TENANT_ID=

# Durable credential store (Task 4). Cifra en reposo las filas de
# whatsapp_auth_keys (AES-256-GCM) antes de escribirlas en Postgres.
# 32 bytes hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_AUTH_ENCRYPTION_KEY=

# Feature Flags (WhatsApp Service Architecture)
# ===========================================
# Controlan la migracion progresiva de servicios monoliticos a modulares.
# Dejar en false para usar la arquitectura legacy estable.
# Nota (T3.1): USE_WHATSAPP_REFACTORED fue eliminado — la implementacion
# Simple es la unica disponible ahora.
# Nota (deuda menor): USE_DATABASE_REPOSITORIES fue eliminado — los repos
# en services/db/* nunca se activaron y se borraron (DatabaseService usa
# Prisma unificado directamente).
USE_AI_MODULAR_SERVICES=false
USE_SESSION_RECOVERY_MODULAR=false
USE_AI_RESPONSE_MODULAR=false
USE_AI_LEARNING_MODULAR=false
USE_WHATSAPP_AUTHORIZATION_MODULAR=true
USE_SESSION_HEALTH_CHECK_MODULAR=false
USE_WHATSAPP_SERVICE_MODULAR=true
