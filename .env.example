# Database Configuration
# Reemplaza con tu URL de Supabase PostgreSQL
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# API Configuration
API_PORT=3001

# Clerk Configuration (si es necesario)
CLERK_SECRET_KEY="your-clerk-secret-key"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your-clerk-publishable-key"

# WhatsApp Service Configuration
WHATSAPP_SERVICE_PORT=3002

# Redis Configuration (opcional)
REDIS_URL="redis://localhost:6379"
