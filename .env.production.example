# ================================================
# LeadsCRM - Production Environment Variables
# ================================================
# Copy this file and rename to .env in each service
# Replace all placeholder values with real credentials

# ================================================
# DATABASE (Supabase PostgreSQL)
# ================================================
# Get these from: Supabase Dashboard > Project Settings > Database
# NOTE: Use a PRODUCTION-ONLY Supabase project here.
# Dev and prod should use separate databases to prevent data mixing.

# Connection pooler URL (for application)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for migrations only)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase client (optional, for direct client access)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ================================================
# AUTHENTICATION (Clerk)
# ================================================
# Get these from: Clerk Dashboard > API Keys
# IMPORTANT: Use PRODUCTION keys (pk_live_, sk_live_)

CLERK_SECRET_KEY="sk_live_xxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxx"
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"
# Webhook separado para eventos organization.* (PR2 - Clerk Organizations).
# Configurar un endpoint independiente en Clerk Dashboard > Webhooks que solo
# se suscriba a organization.created|updated|deleted apuntando a:
#   https://api.TUDOMINIO.com/api/webhooks/clerk/organizations
CLERK_ORG_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"
CLERK_ISSUER="https://clerk.TUDOMINIO.com"

# Auth URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ================================================
# AI PROVIDERS
# ================================================
# Choose one primary provider

AI_PROVIDER="openrouter"  # Options: openrouter | gemini | openai

# OpenRouter (recommended for production)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxx"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Google Gemini (alternative)
GEMINI_API_KEY="AIzaSy..."

# OpenAI (alternative)
OPENAI_API_KEY="sk-xxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# ================================================
# WHATSAPP SERVICE
# ================================================
# API y WhatsApp corren en el mismo servidor Hetzner

WHATSAPP_WEBHOOK_SECRET="generate-a-secure-random-string-here"
WHATSAPP_SERVICE_URL="https://whatsapp.TUDOMINIO.com"

# Proactive messaging consent window.
# A proactive send requires BOTH whatsapp_authorized=true AND an inbound
# message from that lead, on that same session, within this many days.
# Default 30. Capped at 90 in code, so raising it further has no effect.
PROACTIVE_INBOUND_WINDOW_DAYS=30

WHATSAPP_SERVICE_PORT=3002
WEBHOOK_URL="https://api.TUDOMINIO.com/whatsapp/webhook"

# ================================================
# PUPPETEER / CHROME (WhatsApp headless browser)
# ================================================
# Siempre headless en servidor sin display
PUPPETEER_HEADLESS=true

# Ruta a Chrome/Chromium en el VPS
# Si usas Docker, esto ya viene configurado en el Dockerfile
# Si corres directo en Linux:
#   sudo apt install chromium-browser
#   CHROME_EXECUTABLE_PATH="/usr/bin/chromium-browser"
# CHROME_EXECUTABLE_PATH=""

# ================================================
# API CONFIGURATION (Hetzner VPS)
# ================================================

API_PORT=3003
API_HOST="0.0.0.0"
NODE_ENV="production"

# ================================================
# DASHBOARD CONFIGURATION
# ================================================

NEXT_PUBLIC_API_URL="https://api.TUDOMINIO.com"
NEXT_PUBLIC_WHATSAPP_SERVICE_URL="https://whatsapp.TUDOMINIO.com"
NEXTAUTH_URL="https://TUDOMINIO.com"
NEXTAUTH_SECRET="generate-a-32-character-secret-here"

# ================================================
# SECURITY
# ================================================
# IMPORTANT: Generate strong random values for production!
# Use: openssl rand -base64 32

JWT_SECRET="generate-a-256-bit-jwt-secret-here"
ENCRYPTION_KEY="32-character-encryption-key!!!!!"

# ================================================
# LOGGING
# ================================================

LOG_LEVEL="info"          # Options: debug | info | warn | error
LOG_FORMAT="json"         # Options: json | combined

# ================================================
# RATE LIMITING
# ================================================

RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100      # Max requests per window

# ================================================
# CORS CONFIGURATION
# ================================================
# Comma-separated list of allowed origins

CORS_ORIGIN="https://TUDOMINIO.com,https://www.TUDOMINIO.com,https://api.TUDOMINIO.com"

# ================================================
# REDIS
# ================================================

REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ================================================
# SESSION SNAPSHOT BACKUP/RESTORE
# ================================================
# Enables session auth backup to PostgreSQL (survives server restarts)
ENABLE_AUTH_SNAPSHOTS=true
# 64-char hex key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SNAPSHOT_ENCRYPTION_KEY="generate-64-char-hex-key-here"
# How often to auto-backup ready sessions (in hours)
SNAPSHOT_INTERVAL_HOURS=4

# ================================================
# SERVICE-TO-SERVICE AUTHENTICATION (T0.4-ter + PR5a-bis)
# ================================================
# HMAC secret compartido por los 3 apps: dashboard (proxy Next en Vercel),
# API Nest (Hetzner) y whatsapp-service (Hetzner). El dashboard y la API
# firman cada request saliente con HMAC-SHA256 sobre
# `${timestamp}.${tenantId}.${body}` (PR5a-bis, contrato tenant-aware);
# whatsapp-service verifica la firma. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotar simultáneamente en Vercel + ambos .env de Hetzner. Si difiere
# entre superficies, cualquier request cross-app falla con 401.
WHATSAPP_SERVICE_HMAC_SECRET="generate-64-char-hex-here"

# Operator role (PR5a-quinquies). Tenant UUID tratado como "operator" para
# mutaciones globales que cruzan tenants: /ai/switch, PUT /system/variables,
# /sessions/health. Dejar UNSET en producción (default fail-closed: 403).
# PR5b lo reemplazará por un claim de rol propio en el JWT de Clerk.
WHATSAPP_OPERATOR_HMAC_TENANT_ID=

# ================================================
# WHATSAPP LEAD MANAGEMENT
# ================================================
WHATSAPP_ALLOW_NEW_LEADS=true
WHATSAPP_REQUIRE_WHITELIST=true
WHATSAPP_BLOCK_NEWSLETTERS=true

# ================================================
# FEATURE FLAGS
# ================================================
LEAD_SCORING_ENABLED=true
ESCORT_SERVICE_ENABLED=true
HUMAN_ESCALATION_THRESHOLD=0.8

# ================================================
# MONITORING (Optional)
# ================================================

# Sentry for error tracking
SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"

# ================================================
# PRODUCTION URLS REFERENCE
# ================================================
# Dashboard:  https://TUDOMINIO.com
# API:        https://api.TUDOMINIO.com
# WhatsApp:   https://whatsapp.TUDOMINIO.com
# ================================================
