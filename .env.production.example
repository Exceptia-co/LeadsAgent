# ================================================
# LeadsCRM - Production Environment Variables
# ================================================
# Copy this file and rename to .env in each service
# Replace all placeholder values with real credentials

# ================================================
# DATABASE (Supabase PostgreSQL)
# ================================================
# Get these from: Supabase Dashboard > Project Settings > Database

# Connection pooler URL (for application)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (for migrations only)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase client (optional, for direct client access)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ================================================
# AUTHENTICATION (Clerk)
# ================================================
# Get these from: Clerk Dashboard > API Keys
# IMPORTANT: Use PRODUCTION keys (pk_live_, sk_live_)

CLERK_SECRET_KEY="sk_live_xxxxxxxxxxxxx"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxx"
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"

# Auth URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# ================================================
# AI PROVIDERS
# ================================================
# Choose one primary provider

AI_PROVIDER="openrouter"  # Options: openrouter | gemini | openai

# OpenRouter (recommended for production)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxx"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Google Gemini (alternative)
GEMINI_API_KEY="AIzaSy..."

# OpenAI (alternative)
OPENAI_API_KEY="sk-xxxxxxxxxxxxx"
OPENAI_MODEL="gpt-4o-mini"

# ================================================
# WHATSAPP SERVICE
# ================================================
# API y WhatsApp corren en el mismo servidor Hetzner

WHATSAPP_WEBHOOK_SECRET="generate-a-secure-random-string-here"
WHATSAPP_SERVICE_URL="https://whatsapp.TUDOMINIO.com"
WHATSAPP_SERVICE_PORT=3002
WEBHOOK_URL="https://api.TUDOMINIO.com/whatsapp/webhook"

# ================================================
# API CONFIGURATION (Hetzner VPS)
# ================================================

API_PORT=3003
API_HOST="0.0.0.0"
NODE_ENV="production"

# ================================================
# DASHBOARD CONFIGURATION
# ================================================

NEXT_PUBLIC_API_URL="https://api.TUDOMINIO.com"
NEXTAUTH_URL="https://TUDOMINIO.com"
NEXTAUTH_SECRET="generate-a-32-character-secret-here"

# ================================================
# SECURITY
# ================================================
# IMPORTANT: Generate strong random values for production!
# Use: openssl rand -base64 32

JWT_SECRET="generate-a-256-bit-jwt-secret-here"
ENCRYPTION_KEY="32-character-encryption-key!!!!!"

# ================================================
# LOGGING
# ================================================

LOG_LEVEL="info"          # Options: debug | info | warn | error
LOG_FORMAT="json"         # Options: json | combined

# ================================================
# RATE LIMITING
# ================================================

RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100      # Max requests per window

# ================================================
# CORS CONFIGURATION
# ================================================
# Comma-separated list of allowed origins

CORS_ORIGIN="https://TUDOMINIO.com,https://www.TUDOMINIO.com,https://api.TUDOMINIO.com"

# ================================================
# REDIS (Optional - for scaling)
# ================================================

REDIS_URL="redis://localhost:6379"

# ================================================
# MONITORING (Optional)
# ================================================

# Sentry for error tracking
SENTRY_DSN="https://xxxxx@sentry.io/xxxxx"

# ================================================
# PRODUCTION URLS REFERENCE
# ================================================
# Dashboard:  https://TUDOMINIO.com
# API:        https://api.TUDOMINIO.com
# WhatsApp:   https://whatsapp.TUDOMINIO.com
# ================================================
